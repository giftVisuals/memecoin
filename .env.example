# ---- Mode ----
# paper = simulate everything, no real funds touched (start here, stay here a while)
# live  = real trades on your real wallet. Requires TRADING_MODE=live AND I_UNDERSTAND_THE_RISK=true
TRADING_MODE=paper
I_UNDERSTAND_THE_RISK=false

# ---- Wallet (live mode only) ----
# Base58-encoded secret key, generated via `node generateWallet.js`.
# NEVER commit this. Set it as a Railway environment variable, not in this file.
SOLANA_PRIVATE_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ---- Dashboard ----
# Web dashboard (G4 Scraper) login. Username is fixed as "g4".
# If left blank, a random password is generated at boot and printed to the
# logs once - set this so it doesn't change every time the service restarts.
DASHBOARD_PASSWORD=
PORT=3000

# ---- Starting paper balance ----
STARTING_PAPER_BALANCE_SOL=0.05

# ---- Data sources ----
PUMPFUN_WS_URL=wss://pumpportal.fun/api/data
DEXSCREENER_API_URL=https://api.dexscreener.com

# ---- Persistence ----
# On Railway, the filesystem resets on every redeploy unless you attach a
# Volume. If you've added one, set this to its mount path (e.g. /data) so
# trade history and dashboard settings survive redeploys. Leave as ./data
# for local dev, or if you haven't set up a Volume yet.
DATA_DIR=./data

# ---- Cloud backup (optional, no Railway Volume needed) ----
# Free alternative to a Volume: a free Upstash Redis database (upstash.com,
# REST API, no CLI/laptop needed - sign up, create a database, copy these
# two values from its dashboard). When set, trade history and settings are
# backed up on every change and restored automatically after a redeploy.
# Leave both blank to disable - everything still works, it just won't
# survive a redeploy without a Volume.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ------------------------------------------------------------------
# Everything below (watchlist, position sizing, safety filters, exit
# rules) is now controlled from the dashboard's Settings tab and stored in
# data/settings.json - changes apply immediately, no redeploy needed. These
# env vars only matter once, as the very first defaults on a brand new
# deploy that has no data/settings.json yet.
# ------------------------------------------------------------------
POSITION_SIZE_SOL=0.01
MAX_CONCURRENT_POSITIONS=3
WATCHLIST_POSITION_MULTIPLIER=2
MIN_LIQUIDITY_SOL=3
MAX_TOP_HOLDER_PCT=25
REQUIRE_MINT_AUTHORITY_RENOUNCED=true
REQUIRE_FREEZE_AUTHORITY_RENOUNCED=true
MIN_TOKEN_AGE_SEC=20
MAX_TOKEN_AGE_SEC=180
MAX_SELL_PRICE_IMPACT_PCT=15
TAKE_PROFIT_PCT=50
STOP_LOSS_PCT=20
TRAILING_STOP_PCT=15
MAX_HOLD_TIME_SEC=900
WATCHLIST_KEYWORDS=trump,elon,musk,melania
