# ---- Mode ----
# paper  = simulate everything, no real funds touched
# live   = real trades on your real wallet. Requires TRADING_MODE=live AND I_UNDERSTAND_THE_RISK=true
# signal = no auto-trading. Watches pump.fun and sends Telegram alerts for
#          you to act on manually. No wallet needed for the alerts themselves
#          - but every alert has a Buy Now button that DOES use
#          SOLANA_PRIVATE_KEY below to execute a real trade if you tap it.
#          See the "Telegram" section below for setup.
TRADING_MODE=signal
I_UNDERSTAND_THE_RISK=false

# ---- Telegram (signal mode only) ----
# 1. Message @BotFather on Telegram (or reuse your existing bot, e.g.
#    @vewogrobot) to get a bot token - looks like 123456789:AAExxxxxxxxxxx
# 2. Open a chat with your bot and send it any message (e.g. "hi") - a bot
#    can't message you first, you have to message it once.
# 3. In a browser, visit:
#    https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
#    and find "chat":{"id": ...} in the response - that number is your chat ID.
#    (Group chat instead of a DM? Add the bot to the group, send a message
#    there, and use that response's chat id instead - it'll be negative.)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Smart wallet watching (signal mode, optional) ----
# Unlike everything else above, this is NOT free. Alerts you when a wallet
# you're tracking (added in the dashboard's Settings tab) buys something.
# Setup:
#   1. Visit https://pumpportal.fun/api/create-wallet in a browser - it
#      returns a new wallet + a linked API key as JSON.
#   2. Send a SMALL amount of SOL (e.g. 0.05) to that wallet's address.
#      Metering is 0.01 SOL per 10,000 trade events streamed, charged from
#      this wallet - keep only what you're comfortable spending in it.
#   3. Set PUMPPORTAL_API_KEY to the "apiKey" value from step 1.
# SECURITY: this key can also place trades using that wallet's funds - treat
# it exactly like a private key. Never share it, never commit it. This is
# a DIFFERENT wallet from SOLANA_PRIVATE_KEY below - don't reuse that one.
# Leave blank to skip this feature entirely; everything else still works.
PUMPPORTAL_API_KEY=

# ---- Wallet (live mode, and signal mode's Buy Now button) ----
# Base58-encoded secret key, generated via `node generateWallet.js`.
# NEVER commit this. Set it as a Railway environment variable, not in this file.
# In signal mode this is optional - only needed if you plan to tap Buy Now
# on an alert. Leave it blank and the alerts still work, Buy Now just shows
# an error if tapped.
SOLANA_PRIVATE_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ---- Dashboard ----
# Web dashboard (G4 Scraper) login. Username is fixed as "g4".
# If left blank, a random password is generated at boot and printed to the
# logs once - set this so it doesn't change every time the service restarts.
DASHBOARD_PASSWORD=
PORT=3000

# ---- Family wallets (optional) ----
# Required only if you want to add extra wallets from the dashboard's
# Wallets tab (e.g. one per family member) beyond the primary one above.
# Any long random string. Each added wallet's private key is encrypted with
# this before being stored - without it set, "Add Wallet" just shows a clear
# error instead of working. Keep this stable once set; changing it makes any
# already-added wallets undecryptable by the bot (you'd still have each
# one's own key from its one-time reveal to import elsewhere).
WALLET_ENCRYPTION_KEY=

# ---- Starting paper balance ----
STARTING_PAPER_BALANCE_SOL=0.05

# ---- Data sources ----
PUMPFUN_WS_URL=wss://pumpportal.fun/api/data
DEXSCREENER_API_URL=https://api.dexscreener.com

# ---- Persistence ----
# On Railway, the filesystem resets on every redeploy unless you attach a
# Volume. If you've added one, set this to its mount path (e.g. /data) so
# trade history and dashboard settings survive redeploys. Leave as ./data
# for local dev, or if you haven't set up a Volume yet.
DATA_DIR=./data

# ---- Cloud backup (optional, no Railway Volume needed) ----
# Free alternative to a Volume: a free Upstash Redis database (upstash.com,
# REST API, no CLI/laptop needed - sign up, create a database, copy these
# two values from its dashboard). When set, trade history and settings are
# backed up on every change and restored automatically after a redeploy.
# Leave both blank to disable - everything still works, it just won't
# survive a redeploy without a Volume.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ------------------------------------------------------------------
# Everything below (watchlist, position sizing, safety filters, exit
# rules) is now controlled from the dashboard's Settings tab and stored in
# data/settings.json - changes apply immediately, no redeploy needed. These
# env vars only matter once, as the very first defaults on a brand new
# deploy that has no data/settings.json yet.
# ------------------------------------------------------------------
POSITION_SIZE_SOL=0.01
MAX_CONCURRENT_POSITIONS=3
WATCHLIST_POSITION_MULTIPLIER=2
MIN_LIQUIDITY_SOL=3
MAX_TOP_HOLDER_PCT=25
REQUIRE_MINT_AUTHORITY_RENOUNCED=true
REQUIRE_FREEZE_AUTHORITY_RENOUNCED=true
MIN_TOKEN_AGE_SEC=20
MAX_TOKEN_AGE_SEC=180
MAX_SELL_PRICE_IMPACT_PCT=15
MIN_MATCH_CONFIDENCE_PCT=50
MIN_HOLDER_COUNT=10
MAX_TOP10_HOLDER_PCT=50
TAKE_PROFIT_PCT=50
STOP_LOSS_PCT=20
TRAILING_STOP_PCT=15
MAX_HOLD_TIME_SEC=900
WATCHLIST_KEYWORDS=trump,elon,musk,melania
